# Copy ke .env dan isi nilai asli. Jangan commit .env.

# LMS (read-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sekolah default
NEXT_PUBLIC_SEKOLAH_ID=
NEXT_PUBLIC_SEKOLAH_NAMA=SMP ABBS Surakarta

# Google Drive + Sheets (OAuth akun sekolah, server only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Ujian aktif
UJIAN_TAHUN_AJARAN=2026/2027
UJIAN_SEMESTER=1
UJIAN_NAMA=Ujian Praktik ICT
UJIAN_DESKRIPSI=
UJIAN_TUTUP=
UJIAN_MUNDUR_JAM=2
UJIAN_MAKS_MB=50
